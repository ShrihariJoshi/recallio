# API
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/recallio?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters

# Media storage. Leave filesystem for local development, or use your R2 values.
MEDIA_STORAGE_PROVIDER=filesystem
MEDIA_STORAGE_DIR=./storage/media
# MEDIA_STORAGE_PROVIDER=s3
# MEDIA_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=your-bucket-name
# MEDIA_S3_ACCESS_KEY_ID=your-access-key-id
# MEDIA_S3_SECRET_ACCESS_KEY=your-secret-access-key

# Web client API base URL (Vite reads this root .env file).
VITE_API_URL=http://localhost:4000/api/v1
