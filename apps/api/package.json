    "@recallio/contracts": "workspace:*",
    "@recallio/scheduler": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "fzstd": "^0.1.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "multer": "^2.0.2",
    "sanitize-html": "^2.18.2",
    "sql.js": "^1.16.0",
    "yauzl": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.4",
    "@types/sanitize-html": "^2.16.2",
    "@types/sql.js": "^1.4.9",
