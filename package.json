{
  "name": "recallio",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "predev": "pnpm --filter @recallio/contracts --filter @recallio/scheduler build",
    "pretypecheck": "pnpm --filter @recallio/contracts --filter @recallio/scheduler build",
    "dev": "pnpm --parallel --filter @recallio/api --filter @recallio/web dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": { "concurrently": "^9.1.2", "typescript": "^5.8.3" }
}
